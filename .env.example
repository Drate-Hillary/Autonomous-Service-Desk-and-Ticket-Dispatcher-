# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security — only needed for privileged
# scripts (e.g. seeding, promoting a user to admin outside the SQL
# editor). Never expose this to the browser (no NEXT_PUBLIC_ prefix) and
# never required by the app's normal request path, which relies on RLS
# via the signed-in user instead.
SUPABASE_SECRET_KEY=
